@using sportal.Services
@inject UserService UserServiceInstance
@inject TenantSyncService TenantSyncServiceInstance


<div id="titleHeader">
    <MatHeadline3 class="textCenter qlik-green-text">Sportal</MatHeadline3>
</div>
<div id="captionHeader">
    <MatHeadline6 class="textCenter">An impersonation portal for Qlik® Cloud</MatHeadline6>
</div>

@if (chipGroups.Length > 0)
{
    <details id="groupContainer" class="qlik-tanzanite">
        <summary id="groupHeader" class="white-text">Groups (@chipGroups.Length)</summary>
        <div class="parentChipGroup header-group-list">

            @foreach (string group in chipGroups)
            {
                <span class="groupChip">@group</span>
            }
        </div>
    </details>
}

@code {
    string[] chipGroups = new string[0];

    protected override async Task OnInitializedAsync()
    {
        await TenantSyncServiceInstance.EnsureInitializedAsync();
        chipGroups = await UserServiceInstance.GetChipGroupsAsync();
    }
}
